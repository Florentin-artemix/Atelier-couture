APP_NAME=AtelierCouture
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de donnees MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ateliercouture
DB_USERNAME=root
DB_PASSWORD=2025

# Stockage des images
# "r2" = Cloudflare R2 (images affichees via l'URL publique R2_PUBLIC_URL).
# Mettre "public" pour stocker en local (storage/app/public via php artisan storage:link).
IMAGES_DISK=r2

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=72526674e14494d5f72192c57b661ed6
R2_SECRET_ACCESS_KEY=c8feff110ca8098bbb5b46cfa5906d5be0aaa08b6d4ae831b4b6f55b7ddd0541
R2_ENDPOINT=https://c298de3d6c8cfa623f8a66bd2add5c36.r2.cloudflarestorage.com
R2_BUCKET=atelier-couture
R2_PUBLIC_URL=https://pub-f9120105ea2d428ab8cd4f1da954a2a5.r2.dev

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Parametres metier AtelierCouture
PRICING_TAUX_REDUCTION_FOURNI=0.80
RAPPEL_PRE_LIVRAISON_JOURS=2
RAPPEL_PRECOMMANDE_HEURES=24
RAPPEL_RELANCE_RETARD_JOURS=3
